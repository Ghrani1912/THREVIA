lib/

# Spark / Hadoop outputs
backend/spark-warehouse/
backend/output/
spark-warehouse/
*.out
derby.log
metastore_db/

# Streamlit cache
dashboard/.streamlit/

# Ad-hoc debug scripts (safe to leave uncommitted - none is referenced by
# tracked code or by a launcher).
backend/realtime/analyze_original_training_data.py
backend/realtime/check_*.py
backend/realtime/compare_*.py
backend/realtime/debug_*.py
backend/realtime/quick_check_data.py
backend/realtime/test_pipeline_accuracy.py
backend/realtime/verify_*.py
backend/ml/comprehensive_eval_report.py
backend/ml/diagnose_lycos_leakage.py
backend/ml/prob_dist_check.py
backend/ml/verify_*.py
backend/processing/verify_*.py

# NOTE - these three are deliberately NOT ignored any more. They are load
# bearing, and ignoring them meant a fresh clone could not follow its own
# documented steps:
#   backend/realtime/populate_mongo.py  - called by start_dashboard.ps1 and
#                                         populate_sample_data.ps1
#   backend/ml/threshold_test.py        - the source of the 0.65 default cited
#                                         by detection_policy.py
#   backend/ml/diagnose_fpr.py          - cited by calibrate_thresholds.py

